# VISION App - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Backend API Configuration
#
# Physical Android device over USB:
#   adb reverse tcp:3000 tcp:3000
#   adb reverse tcp:8001 tcp:8001
#   adb reverse tcp:8002 tcp:8002
# Then you can keep localhost-based URLs.
#
# Android Studio emulator:
#   use http://10.0.2.2 for the host machine.
#
EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_IP:3000/api
EXPO_PUBLIC_BIOMETRIC_API_BASE_URL=http://YOUR_PC_IP:8001/api/v1

# Number plate recognition (ANPR) service. Only the security gate screens call it; every
# other screen works without it running.
EXPO_PUBLIC_ANPR_API_BASE_URL=http://YOUR_PC_IP:8002/api/v1

# Google Sign-In - OPTIONAL.
# Email + password is the primary credential and needs none of these. Fill them in only
# when enabling the secondary "Sign in with Google" button, which also requires the
# Android SHA-1 registered in the Firebase console and a real google-services.json.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App Configuration
EXPO_PUBLIC_APP_ENV=development

# Offer the demo staff credentials as a one-tap prefill on the staff sign-in tabs.
# A development build already does this; set it to 1 only for a demo build handed to
# someone else. The credentials are published in the repository - they protect nothing.
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=
EXPO_PUBLIC_DEBUG_MODE=true

# NOTES:
# - Everything prefixed EXPO_PUBLIC_ is embedded in the app bundle and readable by anyone
#   who installs it. Never put a secret here.
# - The app uses @react-native-firebase/auth for sessions. All data operations go through
#   the Backend API; the app never writes to Firestore directly.
# - A development build is required - Expo Go cannot load this app's native modules.
#   See VISION.md ADR-005.
# - Get Google OAuth Client IDs from: https://console.cloud.google.com
# - When testing on a physical Android device, use your computer's LAN IP, not localhost.

# Admin console in the browser (npx expo start --web) only. The phone app does not use these.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# Public identifiers, not secrets: they ship in every Firebase web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
