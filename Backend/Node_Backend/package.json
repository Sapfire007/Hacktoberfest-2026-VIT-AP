{
  "name": "vision-backend",
  "version": "1.0.0",
  "description": "VISION Campus Access Management System - Backend API (TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed:admin": "ts-node-dev --transpile-only src/scripts/seed-admin.ts",
    "seed:demo-staff": "ts-node-dev --transpile-only src/scripts/seed-demo-staff.ts",
    "reset:faculty-password": "ts-node-dev --transpile-only src/scripts/reset-faculty-password.ts",
    "audit:accounts": "ts-node-dev --transpile-only src/scripts/audit-accounts.ts"
  },
  "keywords": [
    "vision",
    "campus-management",
    "firebase",
    "express",
    "authentication",
    "typescript"
  ],
  "author": "Saptarshi - VIT-AP University",
  "license": "MIT",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "argon2": "^0.31.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
