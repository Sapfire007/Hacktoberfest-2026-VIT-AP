# VISION Backend - Environment Variables Template
# Copy this to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firestore Collections
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_VISITS=visit_requests
FIRESTORE_COLLECTION_PERMITS=visit_permits
FIRESTORE_COLLECTION_VEHICLES=vehicles
FIRESTORE_COLLECTION_BIOMETRICS=biometrics
# Employee-ID credentials for faculty / security / admin (bcrypt hashes only)
FIRESTORE_COLLECTION_STAFF=staff_credentials
# Walk-in visitors registered at the gate by a security officer
FIRESTORE_COLLECTION_GATE_ENTRIES=gate_entries

# Security
# Note: this service issues no JWTs of its own. Every session is a Firebase ID token,
# including the employee-ID track, which goes through a Firebase custom token
# (VISION.md ADR-003). There is no JWT secret to set.
# HMAC key that signs QR gate passes. REQUIRED before any pass can be issued or scanned.
# There is no default: a pass signed with a shared default key is an unsigned pass.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every pass already in circulation, so rotate it between shifts,
# not during one.
GATE_PASS_SECRET=

# Rate limiting (src/middleware/rateLimit.middleware.ts)
# Per signed-in user, not per IP: a campus shares a few public IPs behind NAT.
# Default: 120 requests per minute per user.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Failed password sign-ins per IP per 15 minutes (successful sign-ins don't count)
RATE_LIMIT_LOGIN_MAX=10
# Unauthenticated requests (email check, password reset) per IP per 15 minutes
RATE_LIMIT_PUBLIC_MAX=30
# Only when deployed behind a reverse proxy: number of proxy hops to trust (usually 1).
# Leave empty when the server is reached directly, or clients can fake their IP.
TRUST_PROXY=
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# Google OAuth — only needed for the optional "Sign in with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log
