# VISION ANPR Backend — environment
# Copy to .env. Nothing here is secret; this service holds no credentials and issues no
# tokens. It reads an image and returns a string.

# --- Server ---
HOST=0.0.0.0
PORT=8002
DEBUG=true

# --- Detection ---
# Plate detector from the open-image-models hub. Downloaded once and cached.
#   yolo-v9-t-384-license-plate-end2end   default: fastest, good enough at a gate
#   yolo-v9-t-512-license-plate-end2end   better on small/distant plates, ~2x the work
#   yolo-v9-t-640-license-plate-end2end   best recall, use only if plates are far away
DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end

# Detections below this score are dropped before OCR. Lower catches more plates at the
# cost of more junk crops, which the format check then rejects anyway.
DETECTOR_CONFIDENCE=0.35

# --- Recognition ---
#   cct-s-v2-global-model    default: more accurate on dirty and angled plates
#   cct-xs-v2-global-model   roughly 2x faster, slightly worse
OCR_MODEL=cct-s-v2-global-model

# Reads below this mean character confidence are returned but flagged, so the gate app
# pre-selects the field for the officer to correct rather than presenting a guess as fact.
OCR_MIN_CONFIDENCE=0.60

# --- Fine-tuned models (optional) ---
# Leave empty to use the pre-trained hub models above. Fill in only after a fine-tune
# from scripts/finetune_ocr.py or scripts/finetune_detector.py has been benchmarked
# against the hub models on the same labelled set.
OCR_MODEL_PATH=
OCR_CONFIG_PATH=
DETECTOR_MODEL_PATH=

# --- Hardware ---
# auto | cuda | cpu. "auto" uses CUDA when onnxruntime-gpu can see a device.
DEVICE=auto

# --- Post-processing ---
# IN applies the Indian plate grammar: positional confusion correction (0/O, 1/I, 5/S,
# 8/B), state-code repair and format validation. Set to "" to return raw OCR unmodified.
PLATE_COUNTRY=IN

# Maximum frames accepted by /read-frames in one temporal-voting call.
MAX_VOTE_FRAMES=8

# --- Upload limits ---
MAX_IMAGE_SIZE_MB=10

# --- Training-data capture ---
# When true, every detected plate crop is written to CROP_STORAGE_PATH. This is how you
# build a fine-tuning set of plates as your own gates actually see them. It writes images
# of real vehicles, so it is off by default and should stay off unless you are collecting.
SAVE_CROPS=false
CROP_STORAGE_PATH=data/crops

# --- CORS ---
# Browser origins allowed to call this service, comma-separated. Leave empty: the app is
# native and needs none, and "*" lets any web page on the network use the GPU.
CORS_ORIGINS=
