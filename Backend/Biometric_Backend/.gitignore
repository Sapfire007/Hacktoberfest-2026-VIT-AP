# ============================================================
# VISION Biometric Backend — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.venv_deepface

# Environment variables (contains encryption keys!)
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data — encrypted embeddings (do NOT commit biometric data)
data/embeddings/

# DeepFace model cache — tracked via Git LFS
# .deepface/weights/*.h5 is tracked by Git LFS

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

