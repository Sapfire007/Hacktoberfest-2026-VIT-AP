# ============================================================
# VISION Biometric Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8001
DEBUG=true

# --- DeepFace Model Configuration ---
# Model: VGG-Face | Facenet | Facenet512 | OpenFace | DeepFace | ArcFace | Dlib | SFace
MODEL_NAME=VGG-Face

# Detector: opencv | ssd | dlib | mtcnn | retinaface | mediapipe | yolov8
DETECTOR_BACKEND=retinaface

# Distance metric: cosine | euclidean | euclidean_l2
DISTANCE_METRIC=cosine

# Verification threshold (model-specific; VGG-Face cosine default ≈ 0.40)
VERIFICATION_THRESHOLD=0.40

# Minimum face detection confidence (0.0 - 1.0)
MIN_FACE_CONFIDENCE=0.90

# Enable anti-spoofing / liveness detection
ANTI_SPOOFING_ENABLED=true

# --- Security ---
# REQUIRED: Fernet encryption key for embedding storage
BIOMETRIC_ENCRYPTION_KEY=

# Every request must carry the caller's Firebase ID token. This service asks Node_Backend
# to verify it, so Node must be running and reachable at NODE_API_BASE_URL.
# false = the old open behaviour (anyone on the network can enrol or delete face data):
# local experiments only.
REQUIRE_AUTH=true
NODE_API_BASE_URL=http://localhost:3000/api

# --- Storage ---
# Path to store encrypted embeddings (relative to project root)
EMBEDDING_STORAGE_PATH=data/embeddings

# --- Upload Limits ---
MAX_IMAGE_SIZE_MB=10

# --- CORS ---
# Comma-separated browser origins allowed to call this service. Leave empty: the app is
# native and needs none, and "*" lets any web page on the network call it.
CORS_ORIGINS=
